<?xml version="1.0" encoding="utf-8"?>
<!-- Main dashboard showing monitoring status -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_child_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hello, Child!"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitoring Dashboard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitoring Status"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- SMS Status -->
                <TextView
                    android:id="@+id/tv_sms_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Monitoring: Checking..."
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Notification Status -->
                <TextView
                    android:id="@+id/tv_notif_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Notifications: Checking..."
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- In-App Chat Status -->
                <TextView
                    android:id="@+id/tv_chat_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="In-App Chat: Active"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Grant Notification Access button (shown only if needed) -->
        <Button
            android:id="@+id/btn_grant_notif_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Notification Access"
            android:backgroundTint="@color/warning"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Open Chat button -->
        <Button
            android:id="@+id/btn_open_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Chat"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"
            android:padding="14dp" />

        <!-- Logout -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
